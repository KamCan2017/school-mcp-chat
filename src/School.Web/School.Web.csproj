<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\School.Contracts\School.Contracts.csproj" />
    <ProjectReference Include="..\School.McpServer\School.McpServer.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <Target Name="CopyMcpServer" AfterTargets="Build">
    <ItemGroup>
      <McpServerOutput Include="..\School.McpServer\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(McpServerOutput)" DestinationFolder="$(OutputPath)mcp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
